---
interface Props {
  kicker: string;
  title: string;
  sub: string;
  image?: string;
  ink?: boolean;
}
const { kicker, title, sub, image, ink = false } = Astro.props;
---

<section class="relative overflow-hidden border-b border-emp-line bg-emp-bg-2">
  {
    image && (
      <div class="absolute inset-0">
        <img src={image} alt="" class="h-full w-full object-cover opacity-30" />
        <div class="absolute inset-0 bg-gradient-to-b from-emp-bg/70 via-emp-bg/80 to-emp-bg"></div>
      </div>
    )
  }
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-14 sm:pt-36 sm:pb-20 text-center" data-reveal>
    <p class="text-xs font-semibold uppercase tracking-[0.35em] text-emp-gold/80" data-reveal-child>{kicker}</p>
    <h1
      class:list={[
        "mt-4 font-serif text-3xl sm:text-5xl font-bold leading-tight",
        ink ? "text-emp-ink" : "emp-grad-text",
      ]}
      data-reveal-child
    >
      {title}
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-base sm:text-lg leading-relaxed text-emp-muted" data-reveal-child>{sub}</p>
  </div>
</section>
