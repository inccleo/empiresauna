---
import type { Locale } from "../lib/site";
import { CONTACT, waLink, tgLink } from "../lib/site";
import { t } from "../i18n";

interface Props {
  locale: Locale;
  justify?: "start" | "center";
  compact?: boolean;
  stack?: boolean;
}
const { locale, justify = "start", compact = false, stack = false } = Astro.props;
const d = t(locale);
const wrap = [
  stack ? "flex flex-col gap-3" : "flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3",
  justify === "center" && !stack ? "justify-center" : "",
].join(" ");
const btnW = stack || compact ? "w-full" : "w-full sm:w-auto";
---

<div class={wrap}>
  <a
    href={waLink(locale)}
    class={`inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-5 py-3.5 font-semibold transition-colors ${btnW} bg-emp-wa-green text-white shadow-lg hover:bg-emp-wa-green-dark`}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
      ><path
        d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.738-.978zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
      ></path></svg
    >
    <span>{d.wa}</span>
  </a>
  <a
    href={tgLink(locale)}
    class={`inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-5 py-3.5 font-semibold transition-colors ${btnW} border border-emp-gold/40 bg-emp-bg-3 text-emp-ink hover:border-emp-gold hover:text-emp-gold`}
  >
    <img src="/icons/telegram.svg" alt="" width="20" height="20" />
    <span>{d.tg}</span>
  </a>
  <a
    href={CONTACT.line}
    class={`inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-5 py-3.5 font-semibold transition-colors ${btnW} border border-emp-gold/40 bg-emp-bg-3 text-emp-ink hover:border-emp-gold hover:text-emp-gold`}
  >
    <img src="/icons/line.svg" alt="" width="20" height="20" />
    <span>{d.line}</span>
  </a>
  <button
    type="button"
    data-wechat-trigger
    class={`inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-5 py-3.5 font-semibold transition-colors ${btnW} border border-emp-gold/40 bg-emp-bg-3 text-emp-ink hover:border-emp-gold hover:text-emp-gold`}
  >
    <img src="/icons/wechat.svg" alt="" width="20" height="20" />
    <span>{d.wechat}</span>
  </button>
</div>
