<div id="lightbox" class="fixed inset-0 z-[150] hidden items-center justify-center bg-black/90 p-4">
  <button id="lightbox-close" type="button" class="absolute top-4 right-4 rounded-full border border-white/30 px-3 py-1 text-sm text-white"
    >✕</button
  >
  <figure class="max-h-[82vh] max-w-5xl">
    <img id="lightbox-img" alt="" class="max-h-[82vh] w-auto max-w-full rounded-xl object-contain" />
    <figcaption id="lightbox-cap" class="mt-3 text-center text-sm text-emp-ink/80"></figcaption>
  </figure>
</div>

<script>
  const e = document.getElementById("lightbox");
  const d = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const n = document.getElementById("lightbox-cap");
  const i = (t: string, c: string) => {
    if (!e || !d) return;
    d.src = t;
    if (n) n.textContent = c;
    e.classList.remove("hidden");
    e.classList.add("flex");
    document.body.style.overflow = "hidden";
  };
  const o = () => {
    if (!e) return;
    e.classList.add("hidden");
    e.classList.remove("flex");
    document.body.style.overflow = "";
  };
  document.querySelectorAll("[data-lightbox]").forEach((t) => {
    t.addEventListener("click", () =>
      i(t.getAttribute("data-lightbox") || "", t.getAttribute("data-caption") || ""),
    );
  });
  document.getElementById("lightbox-close")?.addEventListener("click", o);
  e?.addEventListener("click", (ev) => {
    if (ev.target === e) o();
  });
  document.addEventListener("keydown", (ev) => {
    if (ev.key === "Escape") o();
  });
</script>
