---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WeChatModal from "../components/WeChatModal.astro";
import Concierge from "../components/Concierge.astro";
import type { Locale } from "../lib/site";
import { CONTACT, LOCALES, VENUE_ADDRESS, localizedPath } from "../lib/site";
import { t } from "../i18n";

interface Props {
  locale?: Locale;
  title: string;
  description: string;
}
const locale: Locale = Astro.props.locale ?? "zh-Hant";
const { title, description } = Astro.props;
const d = t(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const siteOrigin = Astro.site?.href?.replace(/\/$/, "") ?? "https://empiresauna.com";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  "@id": `${siteOrigin}/#empire-sauna`,
  name: "巨亨桑拿 Empire Sauna",
  alternateName: [
    "巨亨桑拿",
    "Empire Sauna",
    "澳門巨亨桑拿",
    "澳門桑拿",
    "澳門桑拿推薦",
    "澳门水疗",
    "Macau Sauna",
    "Macao Sauna",
    "マカオサウナ",
    "마카오 사우나",
  ],
  description,
  url: siteOrigin,
  image: `${siteOrigin}/og/empire-sauna-og.jpg`,
  telephone: CONTACT.whatsapp,
  address: {
    "@type": "PostalAddress",
    streetAddress: VENUE_ADDRESS.streetPt,
    addressLocality: VENUE_ADDRESS.locality,
    addressRegion: VENUE_ADDRESS.region,
    addressCountry: "MO",
  },
  geo: {
    "@type": "GeoCoordinates",
    // Approximate for Rua de Xangai, Macau Peninsula
    latitude: 22.193,
    longitude: 113.546,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: "00:00",
    closes: "23:59",
  },
  priceRange: "MOP 1,088 – 6,388",
  keywords: d.keywords,
  sameAs: [CONTACT.telegramUrl, CONTACT.line],
};
---

<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={d.keywords} />
    <link rel="canonical" href={canonical.href} />
    {
      LOCALES.map((loc) => (
        <link rel="alternate" hreflang={loc.hreflang} href={new URL(localizedPath(loc.code, path), Astro.site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath("zh-Hant", path), Astro.site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={d.ogLocale} />
    <meta property="og:site_name" content="巨亨桑拿 Empire Sauna｜澳門桑拿" />
    <meta property="og:image" content="/og/empire-sauna-og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+HK:wght@400;500;700;900&family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Sans+KR:wght@400;500;700;900&family=Noto+Serif+HK:wght@500;700;900&family=Playfair+Display:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <WeChatModal locale={locale} />
    <Concierge locale={locale} />
    <script>
      (function () {
        const els = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-in"));
          return;
        }
        function stagger(el: Element) {
          const kids = el.querySelectorAll<HTMLElement>("[data-reveal-child]");
          if (!kids.length) return;
          const rows: Record<string, HTMLElement[]> = {};
          kids.forEach((kid) => {
            const y = String(Math.round(kid.offsetTop / 8) * 8);
            (rows[y] ||= []).push(kid);
          });
          const yKeys = Object.keys(rows).sort((a, b) => Number(a) - Number(b));
          yKeys.forEach((key, r) => {
            rows[key].forEach((kid, c) => {
              kid.style.setProperty("--reveal-i", String(Math.min(r * rows[key].length + c, 8)));
            });
          });
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                stagger(e.target);
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        const vh = window.innerHeight;
        els.forEach((el) => {
          if (el.getBoundingClientRect().top < vh * 0.9) {
            stagger(el);
            el.classList.add("is-in");
          } else io.observe(el);
        });
      })();
    </script>
  </body>
</html>
