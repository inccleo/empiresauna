---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Lightbox from "../../components/Lightbox.astro";
import { t } from "../../i18n";
import { GALLERY, galleryCaption, type Locale } from "../../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<Base locale={locale} title={d.gallery.title} description={d.gallery.desc}>
  <PageHero kicker={d.gallery.kicker} title={d.gallery.h1} sub={d.gallery.sub} image="/images/cover-bath-pools.webp" />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4" data-reveal>
      {
        GALLERY.map((g) => (
          <button
            type="button"
            class="group relative overflow-hidden rounded-xl border border-emp-line"
            data-reveal-child
            data-lightbox={g.src}
            data-caption={galleryCaption(g, locale)}
          >
            <img
              src={g.src}
              alt={galleryCaption(g, locale)}
              class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-emp-bg/90 to-transparent px-4 pb-3 pt-8 text-left text-sm font-medium text-emp-ink">
              {galleryCaption(g, locale)}
            </span>
          </button>
        ))
      }
    </div>
    <h2 class="mt-16 text-center font-serif text-3xl font-bold text-emp-ink" data-reveal>{d.gallery.videoH2}</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 max-w-3xl mx-auto" data-reveal>
      <video class="w-full rounded-2xl border border-emp-line bg-black" controls preload="none" playsinline poster="/video/empire-tour-43-poster.jpg">
        <source src="/video/empire-tour-43.mp4" type="video/mp4" />
      </video>
      <video class="w-full rounded-2xl border border-emp-line bg-black" controls preload="none" playsinline poster="/video/empire-tour-45-poster.jpg">
        <source src="/video/empire-tour-45.mp4" type="video/mp4" />
      </video>
    </div>
  </section>
  <Lightbox />
</Base>
