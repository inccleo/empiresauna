---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { t } from "../../i18n";
import { prefix, type Locale } from "../../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const p = prefix(locale);
---

<Base locale={locale} title={d.overnight.title} description={d.overnight.desc}>
  <PageHero kicker={d.overnight.kicker} title={d.overnight.h1} sub={d.overnight.sub} image="/images/recliner-lounge.webp" />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <p class="text-base leading-relaxed text-emp-muted" data-reveal>{d.overnight.lead}</p>
    <div class="mt-10 space-y-4" data-reveal>
      {
        d.overnight.cards.map((c) => (
          <div class="rounded-2xl border border-emp-line bg-emp-bg-2/60 p-6" data-reveal-child>
            <h2 class="font-serif text-xl font-bold text-emp-gold">{c.t}</h2>
            <p class="mt-2 text-sm leading-relaxed text-emp-muted">{c.d}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-10 text-sm leading-relaxed text-emp-muted" data-reveal>
      {d.overnight.note}
      {" "}
      <a href={`${p}/pricing/`} class="text-emp-gold underline-offset-2 hover:underline">{d.linkPricing}</a>
      {" · "}
      <a href={`${p}/guide/`} class="text-emp-gold underline-offset-2 hover:underline">{d.linkGuide}</a>
    </p>
    <div class="mt-12">
      <CtaBand locale={locale} title={d.overnight.ctaH2} sub={d.overnight.ctaP} variant="card" ink />
    </div>
  </section>
</Base>
