---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { t } from "../../i18n";
import { GALLERY, galleryCaption, type Locale } from "../../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const env = GALLERY.slice(0, 6);
---

<Base locale={locale} title={d.rooms.title} description={d.rooms.desc}>
  <PageHero kicker={d.rooms.kicker} title={d.rooms.h1} sub={d.rooms.sub} image="/images/marble-suite-lg.webp" />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 space-y-16">
    {
      d.rooms.items.map((r, i) => (
        <article class="grid gap-8 lg:grid-cols-2 lg:items-center" data-reveal>
          <div class:list={["overflow-hidden rounded-2xl border border-emp-line", i % 2 === 1 && "lg:order-2"]} data-reveal-child>
            <img src={r.img} alt={r.alt} class="aspect-[4/3] w-full object-cover" />
          </div>
          <div class:list={[i % 2 === 1 && "lg:order-1"]} data-reveal-child>
            <h2 class="font-serif text-3xl font-bold text-emp-gold">{r.t}</h2>
            <p class="mt-4 text-base leading-relaxed text-emp-muted">{r.d}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="bg-emp-bg-2 border-y border-emp-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <h2 class="text-center font-serif text-3xl font-bold text-emp-ink" data-reveal>{d.rooms.envH2}</h2>
      <div class="mt-10 grid grid-cols-2 lg:grid-cols-3 gap-4" data-reveal>
        {
          env.map((g) => (
            <figure class="group relative overflow-hidden rounded-xl border border-emp-line" data-reveal-child>
              <img
                src={g.src}
                alt={galleryCaption(g, locale)}
                class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-emp-bg/90 to-transparent px-4 pb-3 pt-8 text-sm font-medium text-emp-ink">
                {galleryCaption(g, locale)}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand locale={locale} title={d.rooms.ctaH2} sub={d.rooms.ctaP} ink />
</Base>
