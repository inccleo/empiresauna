---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { t } from "../../i18n";
import type { Locale } from "../../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<Base locale={locale} title={d.privacy.title} description={d.privacy.desc}>
  <PageHero kicker={d.privacy.kicker} title={d.privacy.h1} sub={d.privacy.sub} />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 space-y-8" data-reveal>
    {
      d.privacy.sections.map((s) => (
        <div data-reveal-child>
          <h2 class="font-serif text-xl font-bold text-emp-gold">{s.t}</h2>
          <p class="mt-3 text-sm leading-relaxed text-emp-muted">{s.d}</p>
        </div>
      ))
    }
    <p class="text-sm leading-relaxed text-emp-muted/80" data-reveal-child>{d.privacy.foot}</p>
  </section>
</Base>
